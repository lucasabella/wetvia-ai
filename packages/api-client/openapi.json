{
  "components": {
    "schemas": {
      "AnswerPoint": {
        "additionalProperties": false,
        "description": "One answer claim with the retrieved source chunks that support it.",
        "properties": {
          "bron_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "minItems": 1,
            "title": "Bron Ids",
            "type": "array"
          },
          "tekst": {
            "minLength": 1,
            "title": "Tekst",
            "type": "string"
          }
        },
        "required": [
          "tekst",
          "bron_ids"
        ],
        "title": "AnswerPoint",
        "type": "object"
      },
      "ChatAnswerEvent": {
        "additionalProperties": false,
        "properties": {
          "answer": {
            "$ref": "#/components/schemas/VerifiedAnswer"
          },
          "type": {
            "const": "answer",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "answer"
        ],
        "title": "ChatAnswerEvent",
        "type": "object"
      },
      "ChatDoneEvent": {
        "additionalProperties": false,
        "properties": {
          "type": {
            "const": "done",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type"
        ],
        "title": "ChatDoneEvent",
        "type": "object"
      },
      "ChatErrorEvent": {
        "additionalProperties": false,
        "properties": {
          "message": {
            "minLength": 1,
            "title": "Message",
            "type": "string"
          },
          "type": {
            "const": "error",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "message"
        ],
        "title": "ChatErrorEvent",
        "type": "object"
      },
      "ChatEvent": {
        "discriminator": {
          "mapping": {
            "answer": "#/components/schemas/ChatAnswerEvent",
            "done": "#/components/schemas/ChatDoneEvent",
            "error": "#/components/schemas/ChatErrorEvent",
            "sources": "#/components/schemas/ChatSourcesEvent"
          },
          "propertyName": "type"
        },
        "oneOf": [
          {
            "$ref": "#/components/schemas/ChatSourcesEvent"
          },
          {
            "$ref": "#/components/schemas/ChatAnswerEvent"
          },
          {
            "$ref": "#/components/schemas/ChatErrorEvent"
          },
          {
            "$ref": "#/components/schemas/ChatDoneEvent"
          }
        ]
      },
      "ChatMessageRequest": {
        "additionalProperties": false,
        "description": "A caller-provided user or assistant turn; callers cannot set system prompts.",
        "properties": {
          "content": {
            "maxLength": 8000,
            "minLength": 1,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "$ref": "#/components/schemas/ChatRole"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatMessageRequest",
        "type": "object"
      },
      "ChatMode": {
        "enum": [
          "local",
          "cloud"
        ],
        "type": "string"
      },
      "ChatRequest": {
        "additionalProperties": false,
        "description": "One chat turn with bounded preceding conversation history.",
        "properties": {
          "messages": {
            "items": {
              "$ref": "#/components/schemas/ChatMessageRequest"
            },
            "maxItems": 40,
            "minItems": 1,
            "title": "Messages",
            "type": "array"
          },
          "mode": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ChatMode"
              },
              {
                "type": "null"
              }
            ]
          },
          "peildatum": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Peildatum"
          }
        },
        "required": [
          "messages"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatRole": {
        "enum": [
          "user",
          "assistant"
        ],
        "type": "string"
      },
      "ChatSourceCard": {
        "additionalProperties": false,
        "description": "A source actually included in the prompt and assigned a visible label.",
        "properties": {
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "label": {
            "title": "Label",
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/SourceMetadataResponse"
          },
          "score": {
            "title": "Score",
            "type": "number"
          },
          "tekst": {
            "title": "Tekst",
            "type": "string"
          }
        },
        "required": [
          "label",
          "chunk_id",
          "tekst",
          "metadata",
          "score"
        ],
        "title": "ChatSourceCard",
        "type": "object"
      },
      "ChatSourcesEvent": {
        "additionalProperties": false,
        "properties": {
          "sources": {
            "items": {
              "$ref": "#/components/schemas/ChatSourceCard"
            },
            "title": "Sources",
            "type": "array"
          },
          "type": {
            "const": "sources",
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "sources"
        ],
        "title": "ChatSourcesEvent",
        "type": "object"
      },
      "FollowUpStep": {
        "additionalProperties": false,
        "description": "A concrete next step with an HTTP(S) destination.",
        "properties": {
          "tekst": {
            "minLength": 1,
            "title": "Tekst",
            "type": "string"
          },
          "url": {
            "format": "uri",
            "minLength": 1,
            "title": "Url",
            "type": "string"
          }
        },
        "required": [
          "tekst",
          "url"
        ],
        "title": "FollowUpStep",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "db": {
            "enum": [
              "ok",
              "error"
            ],
            "title": "Db",
            "type": "string"
          },
          "llm_provider": {
            "enum": [
              "ollama",
              "openai_compat"
            ],
            "title": "Llm Provider",
            "type": "string"
          },
          "status": {
            "enum": [
              "ok",
              "degraded"
            ],
            "title": "Status",
            "type": "string"
          },
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": [
          "status",
          "db",
          "llm_provider",
          "version"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ScoredChunkResponse": {
        "properties": {
          "score": {
            "title": "Score",
            "type": "number"
          },
          "source": {
            "$ref": "#/components/schemas/SourceDocumentResponse"
          }
        },
        "required": [
          "source",
          "score"
        ],
        "title": "ScoredChunkResponse",
        "type": "object"
      },
      "SearchResponse": {
        "properties": {
          "results": {
            "items": {
              "$ref": "#/components/schemas/ScoredChunkResponse"
            },
            "title": "Results",
            "type": "array"
          }
        },
        "required": [
          "results"
        ],
        "title": "SearchResponse",
        "type": "object"
      },
      "SourceDocumentResponse": {
        "properties": {
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "metadata": {
            "$ref": "#/components/schemas/SourceMetadataResponse"
          },
          "tekst": {
            "title": "Tekst",
            "type": "string"
          }
        },
        "required": [
          "chunk_id",
          "tekst",
          "metadata"
        ],
        "title": "SourceDocumentResponse",
        "type": "object"
      },
      "SourceMetadataResponse": {
        "properties": {
          "artikel": {
            "title": "Artikel",
            "type": "string"
          },
          "artikel_status": {
            "enum": [
              "geldend",
              "vervallen"
            ],
            "title": "Artikel Status",
            "type": "string"
          },
          "bron_url": {
            "title": "Bron Url",
            "type": "string"
          },
          "bwb_id": {
            "title": "Bwb Id",
            "type": "string"
          },
          "geldig_tot": {
            "anyOf": [
              {
                "format": "date",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Geldig Tot"
          },
          "geldig_vanaf": {
            "format": "date",
            "title": "Geldig Vanaf",
            "type": "string"
          },
          "kop_pad": {
            "title": "Kop Pad",
            "type": "string"
          },
          "lid": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Lid"
          },
          "onderdeel": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Onderdeel"
          },
          "opschrift": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Opschrift"
          },
          "regeling_titel": {
            "title": "Regeling Titel",
            "type": "string"
          },
          "status": {
            "enum": [
              "geldend",
              "toekomstig",
              "vervallen"
            ],
            "title": "Status",
            "type": "string"
          },
          "toestand_url": {
            "title": "Toestand Url",
            "type": "string"
          }
        },
        "required": [
          "bwb_id",
          "regeling_titel",
          "artikel",
          "lid",
          "onderdeel",
          "opschrift",
          "kop_pad",
          "bron_url",
          "toestand_url",
          "geldig_vanaf",
          "geldig_tot",
          "status",
          "artikel_status"
        ],
        "title": "SourceMetadataResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "VerifiedAnswer": {
        "additionalProperties": false,
        "description": "Server response; verifier diagnostics are added after model generation.",
        "properties": {
          "peildatum": {
            "format": "date",
            "title": "Peildatum",
            "type": "string"
          },
          "punten": {
            "items": {
              "$ref": "#/components/schemas/AnswerPoint"
            },
            "title": "Punten",
            "type": "array"
          },
          "samenvatting": {
            "minLength": 1,
            "title": "Samenvatting",
            "type": "string"
          },
          "status": {
            "enum": [
              "beantwoord",
              "onzeker",
              "buiten_scope"
            ],
            "title": "Status",
            "type": "string"
          },
          "verifier_notes": {
            "items": {
              "type": "string"
            },
            "title": "Verifier Notes",
            "type": "array"
          },
          "vervolgstappen": {
            "items": {
              "$ref": "#/components/schemas/FollowUpStep"
            },
            "title": "Vervolgstappen",
            "type": "array"
          },
          "voorbehouden": {
            "items": {
              "type": "string"
            },
            "title": "Voorbehouden",
            "type": "array"
          }
        },
        "required": [
          "status",
          "samenvatting",
          "punten",
          "voorbehouden",
          "vervolgstappen",
          "peildatum"
        ],
        "title": "VerifiedAnswer",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Wetvia",
    "version": "0.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/chat": {
      "post": {
        "description": "Generate one answer; never switch providers based on request input.",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "text/event-stream": {
                "schema": {
                  "type": "string"
                },
                "x-event-schema": {
                  "$ref": "#/components/schemas/ChatEvent"
                }
              }
            },
            "description": "Server-sent events: sources, answer, optional error, then done."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Chat",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "read_health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Read Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/search": {
      "get": {
        "operationId": "search_chunks_api_search_get",
        "parameters": [
          {
            "in": "query",
            "name": "q",
            "required": true,
            "schema": {
              "maxLength": 2000,
              "minLength": 1,
              "title": "Q",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "peildatum",
            "required": true,
            "schema": {
              "format": "date",
              "title": "Peildatum",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "k",
            "required": false,
            "schema": {
              "default": 8,
              "maximum": 60,
              "minimum": 1,
              "title": "K",
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "include_future",
            "required": false,
            "schema": {
              "default": false,
              "title": "Include Future",
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SearchResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Search Chunks",
        "tags": [
          "search"
        ]
      }
    },
    "/api/sources/{chunk_id}": {
      "get": {
        "operationId": "read_source_api_sources__chunk_id__get",
        "parameters": [
          {
            "in": "path",
            "name": "chunk_id",
            "required": true,
            "schema": {
              "format": "uuid",
              "title": "Chunk Id",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SourceDocumentResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Read Source",
        "tags": [
          "search"
        ]
      }
    }
  }
}
