# Placeholders only. Copy to `.env` (gitignored) and fill in locally.
# Never commit real secrets, keys, or model files.

# Optional browser-visible API base URL. Empty uses the web origin; Vite proxies
# /api to the local FastAPI service during `pnpm dev`.
PUBLIC_API_BASE_URL=

# PostgreSQL. Compose binds 5432 to 127.0.0.1 and reads these values.
# POSTGRES_PASSWORD must stay URL-safe: api/worker put it in DATABASE_URL.
# Keep the password in DATABASE_URL below identical to POSTGRES_PASSWORD.
# That URL is for processes on the host. Containers use host name `db`.
POSTGRES_USER=wetvia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wetvia
DATABASE_URL=postgresql+psycopg://wetvia:change-me@127.0.0.1:5432/wetvia

# Local Ollama is the default. LLM_BASE_URL here is for processes on the host.
# Docker Compose replaces it with host.docker.internal for the api/worker.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
# Optional cloud provider (Scaleway, Paris/EU). Keep this pinned URL: an
# OpenAI-compatible protocol does not establish EU residency. Cloud is
# configured only when this URL, a model, and a key are present. Never commit a real key.
CLOUD_LLM_BASE_URL=https://api.scaleway.ai/v1
CLOUD_LLM_MODEL=qwen3.8-27b
LLM_API_KEY=
# Legacy migration: if an old .env has LLM_PROVIDER=openai_compat, its old
# LLM_BASE_URL and LLM_MODEL are copied to CLOUD_LLM_*; local values reset to
# the defaults above. Remove LLM_PROVIDER after upgrading.

# Retrieval abstention threshold. Default 0.01 is provisional until issue #13's
# human-reviewed evaluation dataset can be used with eval/calibrate_tau.py.
ANSWER_ABSTENTION_TAU=0.01

# Local embedding model id. Not a secret.
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
