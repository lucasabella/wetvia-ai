# Placeholders only. Copy to `.env` (gitignored) and fill in locally.
# Never commit real secrets, keys, or model files.

# PostgreSQL. Compose binds 5432 to 127.0.0.1 and reads these values.
# POSTGRES_PASSWORD must stay URL-safe: api/worker put it in DATABASE_URL.
# Keep the password in DATABASE_URL below identical to POSTGRES_PASSWORD.
# That URL is for processes on the host. Containers use host name `db`.
POSTGRES_USER=wetvia
POSTGRES_PASSWORD=change-me
POSTGRES_DB=wetvia
DATABASE_URL=postgresql+psycopg://wetvia:change-me@127.0.0.1:5432/wetvia

# LLM provider: ollama | openai_compat
# LLM_BASE_URL here is for processes on the host. 127.0.0.1 inside a container
# is the container, so docker-compose.yml sets api/worker LLM_BASE_URL to
# http://host.docker.internal:11434 (Ollama on the host) unless you change it.
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL=qwen3.5:9b
# Optional. Leave empty for local Ollama. Never commit a real key.
LLM_API_KEY=

# Local embedding model id. Not a secret.
EMBEDDING_MODEL=intfloat/multilingual-e5-large-instruct
EMBEDDING_DIMENSION=1024
EMBEDDING_BATCH_SIZE=32
